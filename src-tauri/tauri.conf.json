{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattice",
  "version": "3.1.5",
  "identifier": "com.lattice.editor",
  "build": {
    "beforeDevCommand": "npm run prepare:desktop-resources && npm run dev",
    "beforeBuildCommand": "npm run prepare:desktop-resources && npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web-dist"
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "resources": [
      "code-oss-runtime/**/*",
      "resources/vscode-typescript/**/*",
      "resources/vscode-js-debug/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Lattice 格致",
        "create": false,
        "dragDropEnabled": false,
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}
