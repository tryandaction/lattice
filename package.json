    "test:desktop:pdf-smoke": "node scripts/desktop-pdf-smoke.mjs",
    "test:run": "vitest run --maxWorkers=1",
    "test:browser-regression": "node scripts/browser-regression.mjs",
    "test:browser-regression:pdf": "node scripts/pdf-browser-regression-segments.mjs",
    "qa:workspace-annotation-manual": "node scripts/workspace-annotation-manual-smoke.mjs",
    "qa:agent-smoke": "node scripts/agent-qa-smoke.mjs",
    "qa:gate": "npm run lint && npm run typecheck && npm run test:docs && npm run test:run && npm run build && npm run tauri:build",
    "qa:gate:extended": "npm run qa:gate && npm run test:browser-regression",
    "release:prepare": "node scripts/prepare-release.mjs",
    "audit:official": "npm audit --registry=https://registry.npmjs.org",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs"
  },
