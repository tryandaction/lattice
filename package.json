    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy:cloudflare": "node scripts/deploy-cloudflare-pages.mjs",
    "deploy:web": "npm run build && npm run deploy:cloudflare",
    "lint": "eslint .",
    "typecheck": "node scripts/ensure-next-type-shims.mjs && tsc --noEmit --incremental false",
    "test": "vitest",
    "test:docs": "node scripts/check-docs.mjs",
