{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "web-dist/types/**/*.ts",
    "web-dist/dev/types/**/*.ts",
    "web-dist-dev/types/**/*.ts",
    "web-dist-dev/dev/types/**/*.ts",
    "web-dist-browser-regression/types/**/*.ts",
    "web-dist-browser-regression/dev/types/**/*.ts",
    ".lattice-build/appearance-dev/types/**/*.ts",
    ".lattice-build/appearance-dev/dev/types/**/*.ts",
    "web-dist-dev-plugins/types/**/*.ts",
    "web-dist-dev-plugins/dev/types/**/*.ts",
    ".lattice-build/integration-dev/types/**/*.ts",
    ".lattice-build/integration-dev/dev/types/**/*.ts",
    ".lattice-build/integration-cold-20261005/types/**/*.ts",
    ".lattice-build/integration-cold-20261005/dev/types/**/*.ts",
    ".lattice-build/agent-context-dev-20261008/types/**/*.ts",
    ".lattice-build/agent-context-dev-20261008/dev/types/**/*.ts",
    ".lattice-build/cloud-team-dev-20261008/types/**/*.ts",
    ".lattice-build/cloud-team-dev-20261008/dev/types/**/*.ts",
    ".lattice-build/cloud-folder-dev/types/**/*.ts",
    ".lattice-build/cloud-folder-dev/dev/types/**/*.ts",
    ".lattice-build/cloud-unified-dev/types/**/*.ts",
    ".lattice-build/cloud-unified-dev/dev/types/**/*.ts",
    ".lattice-build/cloud-managed-ui-dev/types/**/*.ts",
    ".lattice-build/cloud-managed-ui-dev/dev/types/**/*.ts",
    ".lattice-build/web-parity-dev-20261015/types/**/*.ts",
    ".lattice-build/web-parity-dev-20261015/dev/types/**/*.ts"
  ],
  "exclude": [
    ".lattice-build",
    "node_modules",
    "src-tauri/code-oss-runtime",
    "src-tauri/resources",
    "src-tauri/target",
    "web-dist-browser-regression",
    "web-dist-dev",
    "web-dist"
  ]
}
